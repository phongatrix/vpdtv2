# ============================================================
# vpdt-forwarder — .env.example
# Chỉ chứa biến hệ thống. CREDENTIAL DỊCH VỤ (VPĐT/Google/Telegram)
# KHÔNG đặt ở đây — lưu mã hóa trong DB qua trang /onboarding.
# ============================================================

# ---- Bảo mật hệ thống (BẮT BUỘC) ----
# Key mã hóa AES-256-GCM cho credentials table
# Tạo bằng: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=your_64_char_hex_key_here

# Secret xác thực cron endpoint
# Tạo bằng: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Mật khẩu đăng nhập dashboard
DASHBOARD_PASSWORD=your_dashboard_password_here

# ---- Database (chọn 1 trong 2) ----
# Option A: Turso (SQLite serverless, miễn phí)
DATABASE_URL=libsql://your-db-name-username.turso.io
DATABASE_AUTH_TOKEN=your_turso_auth_token

# Option B: SQLite local (chỉ dùng dev)
# DATABASE_URL=file:./dev.db

# ---- Tùy chọn ----
# Proxy để tránh WAF (nếu cần)
# PROXY_URL=http://user:pass@proxy-host:port

# URL gốc của app (cho OAuth callback)
NEXTAUTH_URL=http://localhost:3000
